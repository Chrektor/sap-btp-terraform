#!/usr/bin/env bash
# ==============================================================================
# SAP BTP & Terraform Environment Variables Template
# Copy this file to 'env.sh' and fill in your credentials.
# Run: source env.sh
# ==============================================================================

# 1. SAP BTP Global Account Information
# The subdomain of your Global Account (found in BTP Cockpit -> Global Account -> Subdomain)
# For trial accounts, this often looks like: "<user-id>trial"
export BTP_GLOBALACCOUNT="your-global-account-subdomain"

# 2. SAP BTP Authentication
# Your SAP Universal ID / BTP email address
export BTP_USERNAME="your-email@example.com"

# Your SAP BTP account password
# Note: For security, you can also leave this empty and let CLI prompt for it,
# or enter it here for unattended Terraform runs.
export BTP_PASSWORD="your-secure-password"

# Optional: SAP BTP CLI Server URL (default is https://cli.btp.cloud.sap)
export BTP_CLI_SERVER_URL="https://cli.btp.cloud.sap"

# Optional: Custom Identity Provider (IAS host, leave empty if using default SAP ID)
# export BTP_IDP=""

# 3. Cloud Foundry (Optional - configured after CF environment is provisioned)
# Target region API endpoint (e.g. us10, eu10, ap21)
export CF_API="https://api.cf.us10.hana.ondemand.com"
export CF_ORG=""
export CF_SPACE="dev"
